# ==========================================
# OpenClaw Docker 本地环境精简版最小配置 (基于 init.sh 逻辑)
# ==========================================

# 1. 核心镜像与数据目录（与 cloud_server 共享同一套预构建镜像）
# ⚠️ 镜像尚未发布到 Docker Hub，docker compose pull 未实现，请先自行构建（见 README / docs/quick-start.md）
OPENCLAW_IMAGE=alpha-gou/openclaw-dockers:latest
# 宿主机数据存放目录
OPENCLAW_DATA_DIR=~/.openclaw
# 容器内工作空间根目录 (保持与 init.sh 默认一致)
OPENCLAW_WORKSPACE_ROOT=/home/node/.openclaw

# 2. 自动化同步开关 (确保环境变量生效)
SYNC_OPENCLAW_CONFIG=true
SYNC_MODEL_CONFIG=true
SYNC_EXTENSIONS_ON_START=true

# 3. 模型配置 (同步到 openclaw.json 的 default 提供商)
MODEL_ID=gpt-4o
BASE_URL=https://api.openai.com/v1
API_KEY=sk-your-key-here
API_PROTOCOL=openai-completions
CONTEXT_WINDOW=128000
MAX_TOKENS=4096

# 4. 网关配置 (Web 控制台登录)
OPENCLAW_GATEWAY_TOKEN=123456
OPENCLAW_GATEWAY_PORT=18789

# 5. 常用渠道 (按需取消注释并填写，init.sh 会自动处理插件安装)
# TELEGRAM_BOT_TOKEN=
# FEISHU_APP_ID=
# FEISHU_APP_SECRET=
# DINGTALK_CLIENT_ID=
# DINGTALK_CLIENT_SECRET=
# DINGTALK_CARD_STREAMING_MODE=answer
# WECOM_BOT_ID=
# WECOM_SECRET=

# 6. 访问方式
# 明文网关端口默认绑 127.0.0.1，直接浏览器访问：
#   http://localhost:18789
# 如需局域网其它机器访问，改 docker-compose.yml 中 ports 前缀为 0.0.0.0
